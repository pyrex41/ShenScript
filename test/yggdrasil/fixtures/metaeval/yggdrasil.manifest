("ratatoskr-manifest" 2)
("kernel-version" "42")
("kernel" "kernel.kl")
("init" shen.initialise)
("user" "metaeval.kl")
("fn" make-expr 1)
("primitives" shen.char-stoutput? shen.char-stinput? type tl set open let lambda eval-kl cond intern <-address address-> absvector value absvector? and close cons? error-to-string freeze get-time if n->string number? or pos read-byte simple-error string? str string->n tlstr trap-error write-byte > < >= <= = / - defun + * cons cn hd)
("primitives-optional" shen.write-string shen.read-unit-string)
("globals" *stinput* *stoutput*)
("needs-eval" true)
("reaches" eval read write file clock)
("cannot-reach")
