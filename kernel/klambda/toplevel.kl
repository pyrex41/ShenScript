" (shen.app (nth (+ 1 V5760) (reverse V5762)) "" shen.a)) (stoutput)) (if (or (= V5761 "") (symbol? V5760)) (shen.recursive-string-match 0 V5761 (reverse V5762)) (simple-error "% expects a number or a symbol
