;; Dynamic source loading and requests matched to worker.js; no native modules.
(define root (getenv "SS_ROOT"))
(define app (getenv "SS_APP"))
(define fixture (getenv "SS_FIXTURE"))
(define (ns kind)
 (let ([t (current-time kind)]) (+ (* (time-second t) 1000000000) (time-nanosecond t))))
(define (bytes) (+ (bytes-allocated) (bytes-deallocated)))
(define (stage name thunk)
 (let* ([c (ns 'time-process)] [w (ns 'time-monotonic)] [b (bytes)]
        [g (collections)] [gc (ns 'time-collector-cpu)] [result (thunk)])
  (printf "STAGE {\"name\":~s,\"cpu_us\":~s,\"wall_ns\":~s,\"allocated_bytes\":~s,\"gc_count\":~s,\"gc_ms\":~s}\n"
    name (quotient (- (ns 'time-process) c) 1000) (- (ns 'time-monotonic) w)
    (- (bytes) b) (- (collections) g) (/ (- (ns 'time-collector-cpu) gc) 1000000.0))
  result))
(define (join strings)
 (if (null? strings) "" (apply string-append (cons (car strings) (map (lambda (s) (string-append "," s)) (cdr strings))))))
(define (json x)
 (cond [(null? x) "[]"] [(pair? x) (string-append "[" (join (map json x)) "]")]
       [(symbol? x) (format "~s" (symbol->string x))] [else (format "~s" x)]))
(kl:tc '-) (kl:set '*hush* #t) (kl:set '*cf.effects* '())
(printf "BOOTSTRAP_CPU_US ~s\nREADY\n" (quotient (ns 'time-process) 1000))
(when (equal? app "suite")
 (let ([sink (open-output-string)])
  (kl:set '*stoutput* sink) (kl:set '*hush* #f)
  (stage "suite" (lambda ()
   (kl:cd (string-append root "/kernel/tests"))
   (kl:load "harness.shen") (kl:load "kerneltests.shen")))
  (let ([log (get-output-string sink)])
   (define (contains? part)
    (let loop ([i 0])
     (and (<= (+ i (string-length part)) (string-length log))
          (or (string=? part (substring log i (+ i (string-length part)))) (loop (+ i 1))))))
   (unless (and (contains? "passed ... 154") (contains? "failed ... 0")) (error 'matched "suite totals differ"))
   (printf "COMPLETE_SUITE ~s\nPASS suite\n" log)))
 (exit 0))
(stage "load" (lambda ()
 (kl:load (string-append root "/kernel/tests/" (if (equal? app "interpreter") "interpreter.shen" "c-minus.shen")))
 (kl:load (string-append fixture "/" app "-main.shen"))))
(define input
 (string-append "main () { int x; "
   (apply string-append (map (lambda (i) (format "x = (x + ~s); " (+ i 1))) (iota 30))) "return x; };"))
(define expected
 (if (equal? app "interpreter") 100
  (list '() (list 'main '() (cons 'compound
   (append (list '(declare int (x)))
    (map (lambda (i) (list 'assign 'x (list '+ 'x (+ i 1)))) (iota 30)) (list '(return x))))))))
(define (request) (if (equal? app "interpreter") (kl:cf.interpreter-request 100) (kl:cf.cminus-request (map string (string->list input)))))
(define (check x) (unless (equal? x expected) (error 'matched "complete output differs" x)))
(let ([first (stage "first" request)]) (check first) (printf "RESULT ~a\n" (json first)))
(stage "persistent-50" (lambda () (do ([i 0 (+ i 1)]) ((= i 50)) (check (request)))))
(stage "typechecking-100" (lambda ()
 (let ([type (if (equal? app "interpreter") 'l-formula 'statement)]
       [term (if (equal? app "interpreter") 1 '(cons return (cons 1 ())))])
  (do ([i 0 (+ i 1)]) ((= i 100))
   (unless (eq? (kl:shen.typecheck term type) type) (error 'matched "typed result differs"))))))
(unless (equal? (kl:value '*cf.effects*) (list (string->symbol app))) (error 'matched "initializer count differs"))
(unless (= (kl:cf.binding-caller 5) 6) (error 'matched "binding before"))
(kl:eval '(define cf.rebinding X -> (+ X 100)))
(unless (= (kl:cf.binding-caller 5) 105) (error 'matched "binding after"))
(printf "PASS ~a\n" app)
